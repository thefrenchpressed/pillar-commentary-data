 "chapter": {
  "number": 12,
  "introduction": "A thanksgiving of the faithful for their redemption, ver. 1-6.",
  "content": [
   {
    "type": "verse",
    "number": 1,
    "content": [
     {
      "text": "In that day - When this great work of the reduction of Israel, and conversion of the Gentiles is fulfilled."
     }
    ]
   },
   {
    "type": "verse",
    "number": 2,
    "content": [
     {
      "text": "God - My salvation hath not been brought to pass by man, but by the almighty power of God."
     }
    ]
   },
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "With joy - Your thirsty souls shall be filled with Divine graces and comforts, which you may draw from God, in the use of gospel - ordinances."
     }
    ]
   }
  ]
 },
