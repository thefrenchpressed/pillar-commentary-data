 "chapter": {
  "number": 35,
  "introduction": "A prophecy against Edom for their hatred to Israel, ver. 1- 13. Their ruin shall be perpetual, ver. 14, 15.",
  "content": [
   {
    "type": "verse",
    "number": 2,
    "content": [
     {
      "text": "Mount Seir - The Edomites, who inhabited it."
     }
    ]
   },
   {
    "type": "verse",
    "number": 5,
    "content": [
     {
      "text": "Their iniquity - When their iniquity was punished on them, which brought them to final ruin."
     }
    ]
   },
   {
    "type": "verse",
    "number": 6,
    "content": [
     {
      "text": "And blood - Thy guilt, and my just revenge of innocent blood. Hast not hated - Thou hast loved, rather than hated, blood - shed; therefore vengeance for it follows thee."
     }
    ]
   },
   {
    "type": "verse",
    "number": 7,
    "content": [
     {
      "text": "That passeth out - All travellers that go to or from Edom."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "Return - To their former glory."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "Though - Though God was with Israel."
     }
    ]
   },
   {
    "type": "verse",
    "number": 11,
    "content": [
     {
      "text": "Judged - Punished thee."
     }
    ]
   },
   {
    "type": "verse",
    "number": 14,
    "content": [
     {
      "text": "The whole earth - The inhabitants of all the countries round about thee. Rejoiceth - Is in peace and plenty."
     }
    ]
   }
  ]
 },
