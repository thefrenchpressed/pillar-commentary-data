 "chapter": {
  "number": 125,
  "introduction": "The safety of them that trust in God, and the fate of the wicked, ver. 1-5. A song of degrees.",
  "content": [
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "The rod - Their power and authority. Not rest - Not continue long. The lot - Upon the habitations and persons of good men. Lest - Lest they should be driven to indirect courses to relieve themselves."
     }
    ]
   },
   {
    "type": "verse",
    "number": 5,
    "content": [
     {
      "text": "Lead them - Unto sinful courses. Israel - Upon the true Israel of God."
     }
    ]
   }
  ]
 },
