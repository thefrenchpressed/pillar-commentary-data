 "chapter": {
  "number": 142,
  "introduction": "David complains to God and trusts in him, ver. 1-7 Maschil of David; A prayer when he was in the cave.",
  "content": [
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "Knowest - So as to direct me to it. My path - What paths I should chuse whereby I might escape."
     }
    ]
   },
   {
    "type": "verse",
    "number": 4,
    "content": [
     {
      "text": "Right - hand - The place where the patron or assistant used to stand."
     }
    ]
   },
   {
    "type": "verse",
    "number": 5,
    "content": [
     {
      "text": "Portion - Even in this life."
     }
    ]
   },
   {
    "type": "verse",
    "number": 7,
    "content": [
     {
      "text": "Prison - Set me at liberty. Compass - Shall flock to me from all parts, to rejoice and bless God with me and for me."
     }
    ]
   }
  ]
 },
