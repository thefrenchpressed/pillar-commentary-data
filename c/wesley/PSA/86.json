 "chapter": {
  "number": 86,
  "introduction": "David prays for the favour and blessing of God, ver. 1-6. Expresses confidence in him, by praise mingled with prayer, ver. 7-17. A prayer of David.",
  "content": [
   {
    "type": "verse",
    "number": 2,
    "content": [
     {
      "text": "Holy - Sincerely devoted to thy service."
     }
    ]
   },
   {
    "type": "verse",
    "number": 11,
    "content": [
     {
      "text": "Truth - In the way of thy precepts, which are true and right in all things. My heart - Knit my whole heart to thyself."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "Hell - From extreme dangers and miseries."
     }
    ]
   }
  ]
