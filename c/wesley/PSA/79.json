 "chapter": {
  "number": 79,
  "introduction": "This psalm seems to have been written by the later Asaph, upon the destruction of Jerusalem by the Chaldeans. It contains, a representation of the deplorable condition of the Jews, ver. 1-5. And a petition for deliverance, ver. 6-13. A psalm of Asaph.",
  "content": [
   {
    "type": "verse",
    "number": 8,
    "content": [
     {
      "text": "Prevent - Prevent our utter extirpation."
     }
    ]
   },
   {
    "type": "verse",
    "number": 11,
    "content": [
     {
      "text": "The prisoner - Of thy poor people now in captivity."
     }
    ]
   }
  ]
 },
