 "chapter": {
  "number": 140,
  "introduction": "David prays and hopes for deliverance from his enemies, ver. 1-7. Foretells their destruction, ver. 8-13. To the chief musician, A psalm of David.",
  "content": [
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "Tongues - Using words as sharp and piercing as the sting of a serpent."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "Mischief - The mischief which they design against me, shall fall upon themselves."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "Coals - Divine vengeance, which is compared to coals of fire."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "Dwell - Shall constantly enjoy thy gracious and powerful presence."
     }
    ]
   }
  ]
 },
