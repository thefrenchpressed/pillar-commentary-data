 "chapter": {
  "number": 71,
  "introduction": "David wrote this psalm in his old age, of which the former part is prayer, ver. 1-13. The latter part, joyful praise and thanksgiving, ver. 14-24.",
  "content": [
   {
    "type": "verse",
    "number": 7,
    "content": [
     {
      "text": "A wonder - For my many and sore calamities."
     }
    ]
   },
   {
    "type": "verse",
    "number": 15,
    "content": [
     {
      "text": "The numbers - Of thy salvations and mercies vouchsafed to me."
     }
    ]
   },
   {
    "type": "verse",
    "number": 16,
    "content": [
     {
      "text": "Make mention - To support and comfort myself with the remembrance of it. Righteousness - Of thy faithfulness in making good all thy promises."
     }
    ]
   },
   {
    "type": "verse",
    "number": 19,
    "content": [
     {
      "text": "Very high - Most eminent."
     }
    ]
   },
   {
    "type": "verse",
    "number": 20,
    "content": [
     {
      "text": "Bring me - From the grave."
     }
    ]
   }
  ]
 },
