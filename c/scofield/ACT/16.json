 "chapter": {
  "number": 16,
  "introduction": null,
  "content": [
   {
    "type": "verse",
    "number": 7,
    "content": [
     {
      "text": "suffered -- R.V. adds \"of Jesus\", as in the best authorities."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "prayed him -- beseeching him. Here the Gospel turns toward Europe."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "we -- The change here from \"they,\" as in the preceding verses, to \"we\" indicates that at Troas Luke, the narrator, joined Paul's company."
     }
    ]
   },
   {
    "type": "verse",
    "number": 12,
    "content": [
     {
      "text": "colony -- i.e. a Roman colony."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "was wont -- might legally, i.e. a legal meeting-place for Jews where there was no synagogue."
     }
    ]
   },
   {
    "type": "verse",
    "number": 16,
    "content": [
     {
      "text": "spirit -- (Greek - Α,\" \"a Python).\""
     }
    ]
   },
   {
    "type": "verse",
    "number": 17,
    "content": [
     {
      "text": "most high God -- (See Scofield \"Matthew 7:22\"). This marks the \"spirit\", Acts 16:18, as being a demon.\n\nsalvation -- See note, (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 19,
    "content": [
     {
      "text": "drew -- (Greek - Α,\" probably by the feet). Cf. Acts 14:19."
     }
    ]
   },
   {
    "type": "verse",
    "number": 20,
    "content": [
     {
      "text": "magistrates -- (Greek - Α,\" Roman magistrates)."
     }
    ]
   },
   {
    "type": "verse",
    "number": 25,
    "content": [
     {
      "text": "prayed -- Lit. were praying and singing hymns."
     }
    ]
   },
   {
    "type": "verse",
    "number": 30,
    "content": [
     {
      "text": "saved -- (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 35,
    "content": [
     {
      "text": "serjeants -- (Greek - Α).\""
     }
    ]
   }
  ]
 },
