 "chapter": {
  "number": 21,
  "introduction": null,
  "content": [
   {
    "type": "verse",
    "number": 4,
    "content": [
     {
      "text": "go up to -- Lit. set foot in. Not, as in Acts 20:23 a warning of danger, but now an imperative command. See Acts 22:17,18."
     }
    ]
   },
   {
    "type": "verse",
    "number": 23,
    "content": [
     {
      "text": "vow -- Probably according to Numbers 6:1-7. Cf. Colossians 2:14-17."
     }
    ]
   },
   {
    "type": "verse",
    "number": 24,
    "content": [
     {
      "text": "charges with them -- Lit. spend something on them.\n\nwalkest orderly -- Lit. art keeping in the ranks, guarding the law. Cf. Romans 10:1-12."
     }
    ]
   },
   {
    "type": "verse",
    "number": 26,
    "content": [
     {
      "text": "Paul took -- Contra. Acts 21:4; Galatians 2:2-6. See,; Romans 3:9,10,19,20,28; 4:3-5; 5:1,2; 6:14; 7:1-4,6; 8:3,4; Galatians 2:15,16,18,19; 3:10,24,25; 4:9-11,21-31; Philippians 3:7-9; Hebrews 9:14,15,28; 10:1-4,17,18 13:11-14"
     }
    ]
   },
   {
    "type": "verse",
    "number": 30,
    "content": [
     {
      "text": "drew -- See, Acts 14:19; 16:19."
     }
    ]
   },
   {
    "type": "verse",
    "number": 37,
    "content": [
     {
      "text": "chief -- (Greek - χιλίαρχος, the Roman tribune). There were six such \"chief captains\" in each legion of 6000 men."
     }
    ]
   }
  ]
 },
