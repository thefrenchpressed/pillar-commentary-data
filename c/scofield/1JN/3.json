     {
      "text": "world -- kosmos = mankind. (See Scofield \"Matthew 4:8\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 4,
    "content": [
     {
      "text": "committeth sin -- practiseth sin practiseth also lawlessness; and sin is lawlessness.\n\nsin -- Sin. (See Scofield \"Romans 3:23\")"
     }
    ]
   },
   {
    "type": "verse",
    "number": 7,
    "content": [
     {
      "text": "righteousness -- \"Righteousness\" here, and in the passages having marginal references to this, means the righteous life which is the result of salvation through Christ. The righteous man under law became righteous by doing righteously; under grace he does righteously because he has been made righteous Romans 3:22.\n\n(See Scofield \"Romans 10:3\")"
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "righteousness -- (See Scofield \"1 John 3:7\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "world -- kosmos = world-system. 1 John 4:3-5; John 7:7. (See Scofield \"Revelation 13:8\")."
     }
    ]
   }
  ]
