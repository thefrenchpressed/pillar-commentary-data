 "chapter": {
  "number": 11,
  "introduction": null,
  "content": [
   {
    "type": "verse",
    "number": 1,
    "content": [
     {
      "text": "Bethphage -- Meaning, house of unripe figs, see Mark 11:12,20. probably so called after the fig tree was cursed."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "kingdom -- (See Scofield \"Matthew 3:2\")"
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "leaves -- Fig trees which have retained their leaves through the winter usually have figs also. It was still too early for new leaves or fruit."
     }
    ]
   },
   {
    "type": "verse",
    "number": 19,
    "content": [
     {
      "text": "when even -- whenever, i.e. every day when evening came."
     }
    ]
   },
   {
    "type": "verse",
    "number": 22,
    "content": [
     {
      "text": "Have faith -- Have the faith of God; i.e. the faith which God gives. Cf. 1 Corinthians 12:9; Ephesians 2:8."
     }
    ]
   },
   {
    "type": "verse",
    "number": 23,
    "content": [
     {
      "text": "whosoever -- See, Matthew 17:20; Luke 11:1 (See Scofield \"Luke 11:1\"); Luke 17:6; John 14:13,14"
     }
    ]
   },
   {
    "type": "verse",
    "number": 26,
    "content": [
     {
      "text": "if ye -- (See Scofield \"Matthew 6:12\"). Verse 26 is omitted from the best MSS."
     }
    ]
   }
  ]
 },
