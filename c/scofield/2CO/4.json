     }
    ]
   },
   {
    "type": "verse",
    "number": 15,
    "content": [
     {
      "text": "abundant grace -- Grace (imparted). 2 Corinthians 6:1-3; Romans 6:1; 2 Peter 3:18."
     }
    ]
   }
