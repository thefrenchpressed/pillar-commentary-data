     {
      "text": "world -- kosmos = mankind. (See Scofield \"Matthew 4:8\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 12,
    "content": [
     {
      "text": "natural brute beasts -- natural animals without reason. Jude 1:10."
     }
    ]
   },
   {
    "type": "verse",
    "number": 14,
    "content": [
     {
      "text": "sin -- Sin. (See Scofield \"Romans 3:23\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 15,
    "content": [
     {
      "text": "Balaam -- Balaam. (See Scofield \"Numbers 22:5\") was the typical hireling prophet, anxious only to make a market of his gift. This is the \"way\" of Balaam. See the \"error\" of Balaam, See Scofield \"Jude 1:11\" and the \"doctrine\" of Balaam, See Scofield \"Revelation 2:14\"."
     }
    ]
   },
   {
    "type": "verse",
    "number": 20,
    "content": [
     {
      "text": "world -- kosmos = world-system.\n\n1 John 2:15-17; John 7:7 (See Scofield \"Revelation 13:8\")\n\nSaviour -- (See Scofield \"Romans 1:16\")."
     }
    ]
   }
  ]
