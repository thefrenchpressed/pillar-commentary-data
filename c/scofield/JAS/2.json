   {
    "type": "verse",
    "number": 1,
    "content": [
     {
      "text": "the Lord of glory -- the Glory, i.e. in the sense of Hebrews 1:3 as taking the place of the shekinah.\n\nwith respect -- In the presence of Christ the Glory, earthly distinctions disappear."
     }
    ]
   },
   {
    "type": "verse",
    "number": 5,
    "content": [
     {
      "text": "world -- kosmos = mankind. (See Scofield \"Matthew 4:8\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "sin -- Sin. (See Scofield \"Romans 3:23\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 11,
    "content": [
     {
      "text": "transgressor -- Sin. (See Scofield \"Romans 3:23\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 14,
    "content": [
     {
      "text": "save -- (See Scofield \"Romans 1:16\")"
     }
    ]
   },
   {
    "type": "verse",
    "number": 21,
    "content": [
     {
      "text": "justified -- (See Scofield \"Romans 4:2\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 22,
    "content": [
     {
      "text": "perfect -- (See Scofield \"Matthew 5:48\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 23,
    "content": [
     {
      "text": "imputation -- Imputation is the act of God whereby He accounts righteousness to the believer in Christ, who has borne the believer's sins in vindication of the law.\n\n(See Scofield \"Philemon 1:18\").\n\nrighteousness -- (See Scofield \"Romans 3:21\")."
     }
    ]
   }
  ]
