     {
      "text": "saved -- (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "righteousness -- The word \"righteousness\" here, and in the passages having marginal references to this, means legal, or self-righteousness; the futile effort of man to work out under law a character which God can approve.\n\n(See Scofield \"Revelation 19:8\").\n\nrighteousness -- Cf. (See Scofield \"Romans 3:21\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "saved -- (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "righteousness -- Righteousness here, and in the passages which refer to Romans 10:10, means that righteousness of God which is judicially reckoned to all who believe on the Lord Jesus Christ; believers are the righteous.\n\n(See Scofield \"Romans 3:21\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "saved -- (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 18,
    "content": [
     {
      "text": "world -- oikoumene = inhabited earth.\n\n(See Scofield \"Luke 2:1\")."
     }
    ]
   }
  ]
 },
