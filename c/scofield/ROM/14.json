    "content": [
     {
      "text": "to doubtful -- for decisions of doubts, i.e. doubts about meats, etc. The church has no authority to decide questions of personal liberty in things not expressly forbidden in Scripture. Romans 14:2-6."
     }
    ]
   },
   {
    "type": "verse",
    "number": 17,
    "content": [
     {
      "text": "kingdom -- See, Galatians 4:9-11; Colossians 2:20-23. (See Scofield \"Matthew 6:33\").\n\nrighteousness -- (See Scofield \"Romans 10:10\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 23,
    "content": [
     {
      "text": "damned -- condemned, i.e. as in Romans 14:22.\n\nsin -- Sin. (See Scofield \"Romans 3:23\")."
     }
    ]
   }
  ]
 },
