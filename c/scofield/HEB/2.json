 "chapter": {
  "number": 2,
  "introduction": null,
  "content": [
   {
    "type": "verse",
    "number": 2,
    "content": [
     {
      "text": "transgression/disobedience -- Sin. (See Scofield \"Romans 3:23\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 3,
    "content": [
     {
      "text": "salvation -- (See Scofield \"Romans 1:16\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 5,
    "content": [
     {
      "text": "world -- \"oikoumene\" = inhabited earth. (See Scofield \"Luke 2:1\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 9,
    "content": [
     {
      "text": "grace -- Grace (in salvation). Hebrews 10:29; Romans 3:24 (See Scofield \"John 1:17\")."
     }
    ]
   },
   {
    "type": "verse",
    "number": 10,
    "content": [
     {
      "text": "captain -- leader, or, originator, i.e. one who initiates and carries through. Trans. \"author\" in Hebrews 12:2."
     }
    ]
   },
   {
    "type": "verse",
    "number": 13,
    "content": [
     {
      "text": "I will put -- Septuagint. Isaiah 8:17.\n\nGod -- Jehovah. Septuagint. Isaiah 8:18."
     }
    ]
   },
   {
    "type": "verse",
    "number": 14,
    "content": [
     {
      "text": "took part -- The word trans. \"took part\" is not the same as the trans. \"partakers,\" but implies taking part in something outside one's self."
     }
    ]
   },
   {
    "type": "verse",
    "number": 16,
    "content": [
     {
      "text": "he took -- not of angels doth he take hold, but he taketh hold of. Cf. Septuagint. Isaiah 41:9."
     }
    ]
   },
   {
    "type": "verse",
    "number": 17,
    "content": [
     {
      "text": "reconciliation -- (Greek - ἱλάσκομαι, propitiation). (See Scofield \"Romans 3:25\")."
     }
    ]
   }
  ]
 },
